@page
@model ApproveModel
@{
    ViewData["Title"] = "Approve Expenses";
}

<div class="container mt-4">
    <div class="card">
        <div class="card-header bg-success text-white">
            <h2>Approve Expenses</h2>
        </div>
        <div class="card-body">
            @if (!string.IsNullOrEmpty(Model.ErrorMessage))
            {
                <div class="alert alert-danger" role="alert">
                    @Model.ErrorMessage
                </div>
            }
            
            <h4 class="mb-3">Pending Expenses:</h4>
            
            <div class="mb-3">
                <input type="text" id="searchFilter" class="form-control" placeholder="Filter..." onkeyup="filterExpenses()" />
            </div>
            
            <div class="table-responsive">
                <table class="table table-striped" id="pendingTable">
                    <thead class="table-success">
                        <tr>
                            <th>Date</th>
                            <th>Category</th>
                            <th>Amount</th>
                            <th>User</th>
                            <th>Description</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var expense in Model.PendingExpenses)
                        {
                            <tr>
                                <td>@expense.ExpenseDate.ToString("dd/MM/yyyy")</td>
                                <td>@expense.CategoryName</td>
                                <td>£@expense.AmountGBP.ToString("0.00")</td>
                                <td>@expense.UserName</td>
                                <td>@expense.Description</td>
                                <td>
                                    <form method="post" class="d-inline">
                                        <input type="hidden" name="expenseId" value="@expense.ExpenseId" />
                                        <button type="submit" name="action" value="approve" class="btn btn-success btn-sm">Approve</button>
                                        <button type="submit" name="action" value="reject" class="btn btn-danger btn-sm">Reject</button>
                                    </form>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
            
            @if (!Model.PendingExpenses.Any())
            {
                <div class="alert alert-info">
                    No pending expenses to approve.
                </div>
            }
            
            <div class="mt-3">
                <a href="/" class="btn btn-secondary">Back to Expenses</a>
            </div>
        </div>
    </div>
</div>

<script>
function filterExpenses() {
    var input = document.getElementById('searchFilter');
    var filter = input.value.toUpperCase();
    var table = document.getElementById('pendingTable');
    var tr = table.getElementsByTagName('tr');
    
    for (var i = 1; i < tr.length; i++) {
        var td = tr[i].getElementsByTagName('td');
        var found = false;
        
        for (var j = 0; j < td.length; j++) {
            if (td[j]) {
                var txtValue = td[j].textContent || td[j].innerText;
                if (txtValue.toUpperCase().indexOf(filter) > -1) {
                    found = true;
                    break;
                }
            }
        }
        
        tr[i].style.display = found ? '' : 'none';
    }
}
</script>
